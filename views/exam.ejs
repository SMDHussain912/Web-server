<!DOCTYPE html>
<html>
<head>
    <title>Exam - Career Navigator</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #fff;
        }

        header {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .container {
            padding: 40px;
            max-width: 900px;
            margin: 0 auto;
        }

        .exam-header {
            text-align: center;
            margin-bottom: 40px;
            animation: fadeInDown 0.8s;
        }

        .exam-header h1 {
            font-size: 42px;
            margin-bottom: 10px;
        }

        .exam-header p {
            font-size: 18px;
            opacity: 0.9;
        }

        .exam-form {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            padding: 40px;
            border-radius: 20px;
            animation: fadeInUp 0.8s;
        }

        .topic-input {
            margin-bottom: 30px;
        }

        .topic-input label {
            display: block;
            margin-bottom: 10px;
            font-size: 18px;
            font-weight: 600;
        }

        .topic-input input {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 16px;
        }

        .topic-input input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .generate-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 15px 40px;
            border-radius: 10px;
            color: white;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s;
            width: 100%;
        }

        .generate-btn:hover {
            transform: translateY(-2px);
        }

        .generate-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .questions-container {
            display: none;
            margin-top: 40px;
        }

        .questions-container.active {
            display: block;
            animation: fadeInUp 0.8s;
        }

        .question-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 25px;
            border-left: 4px solid #ffd93d;
        }

        .question-number {
            display: inline-block;
            background: #ffd93d;
            color: #333;
            padding: 5px 15px;
            border-radius: 20px;
            font-weight: bold;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .question-text {
            font-size: 18px;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .options-grid {
            display: grid;
            gap: 12px;
        }

        .option-label {
            display: flex;
            align-items: center;
            padding: 15px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            cursor: pointer;
            transition: background 0.3s;
        }

        .option-label:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .option-label input[type="radio"] {
            margin-right: 12px;
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

        .option-text {
            flex: 1;
            font-size: 16px;
        }

        .submit-exam-btn {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            border: none;
            padding: 18px 40px;
            border-radius: 10px;
            color: white;
            font-size: 20px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s;
            width: 100%;
            margin-top: 30px;
        }

        .submit-exam-btn:hover {
            transform: translateY(-2px);
        }

        .loading {
            display: none;
            text-align: center;
            padding: 40px;
        }

        .loading.active {
            display: block;
        }

        .spinner {
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-top: 4px solid #fff;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .error-msg {
            background: rgba(255, 71, 87, 0.2);
            border: 1px solid #ff4757;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: none;
            text-align: center;
        }

        .error-msg.active {
            display: block;
        }

        .result-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .result-modal.active {
            display: flex;
        }

        .result-content {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 50px;
            border-radius: 20px;
            text-align: center;
            max-width: 500px;
            width: 90%;
            animation: scaleIn 0.5s;
        }

        @keyframes scaleIn {
            from {
                transform: scale(0.5);
                opacity: 0;
            }
            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .result-content i {
            font-size: 80px;
            margin-bottom: 20px;
        }

        .result-content h2 {
            font-size: 36px;
            margin-bottom: 15px;
        }

        .result-content p {
            font-size: 20px;
            margin-bottom: 30px;
        }

        .result-content button {
            background: white;
            color: #667eea;
            border: none;
            padding: 15px 40px;
            border-radius: 10px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
        }

        footer {
            text-align: center;
            padding: 30px;
            margin-top: 50px;
            background: rgba(0, 0, 0, 0.2);
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 768px) {
            header {
                padding: 15px 20px;
            }

            .container {
                padding: 20px;
            }

            .exam-header h1 {
                font-size: 32px;
            }

            .exam-form {
                padding: 25px;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <i class="fas fa-graduation-cap"></i>
            Career Navigator
        </div>
        <nav class="nav-links">
            <a href="/dashboard"><i class="fas fa-home"></i> Home</a>
        </nav>
    </header>

    <div class="container">
        <div class="exam-header">
            <h1>📝 Practice Exam</h1>
            <p>Test your knowledge with AI-generated questions</p>
        </div>

        <div class="error-msg" id="errorMsg"></div>

        <div class="exam-form">
            <div class="topic-input">
                <label for="topic">Enter Exam Topic</label>
                <input type="text" id="topic" placeholder="e.g., Java Variables, Python Loops, HTML Basics..." required>
            </div>

            <button class="generate-btn" id="generateBtn" onclick="generateExam()">
                <i class="fas fa-magic"></i> Generate Exam
            </button>

            <div class="loading" id="loading">
                <div class="spinner"></div>
                <p>AI is generating your exam questions...</p>
            </div>

            <div class="questions-container" id="questionsContainer">
                <form id="examForm" onsubmit="submitExam(event)">
                    <div id="questionsList"></div>
                    <button type="submit" class="submit-exam-btn">
                        <i class="fas fa-paper-plane"></i> Submit Exam
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="result-modal" id="resultModal">
        <div class="result-content">
            <i class="fas fa-trophy" id="resultIcon"></i>
            <h2 id="resultTitle">Exam Complete!</h2>
            <p id="resultMessage"></p>
            <button onclick="closeModal()">Continue</button>
        </div>
    </div>

    <footer>
        <p>&copy; 2024 Career Navigator AI System. All rights reserved.</p>
    </footer>

    <script>
        let currentQuestions = [];
        let currentTopic = '';

        function showError(message) {
            const errorMsg = document.getElementById('errorMsg');
            errorMsg.textContent = message;
            errorMsg.classList.add('active');
            setTimeout(() => {
                errorMsg.classList.remove('active');
            }, 5000);
        }

        async function generateExam() {
            const topic = document.getElementById('topic').value;
            const generateBtn = document.getElementById('generateBtn');
            const loading = document.getElementById('loading');
            const questionsContainer = document.getElementById('questionsContainer');

            if (!topic.trim()) {
                showError('Please enter a topic');
                return;
            }

            generateBtn.disabled = true;
            loading.classList.add('active');
            questionsContainer.classList.remove('active');

            try {
                const response = await fetch('/generateExam', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ topic })
                });

                if (!response.ok) {
                    throw new Error('Failed to generate exam');
                }

                const data = await response.json();
                currentQuestions = data.questions;
                currentTopic = data.topic;

                displayQuestions(currentQuestions);
            } catch (error) {
                showError(error.message);
            } finally {
                generateBtn.disabled = false;
                loading.classList.remove('active');
            }
        }

        function displayQuestions(questions) {
            const questionsList = document.getElementById('questionsList');
            const questionsContainer = document.getElementById('questionsContainer');

            questionsList.innerHTML = questions.map((q, index) => `
                <div class="question-card">
                    <span class="question-number">Question ${index + 1}</span>
                    <div class="question-text">${q.question}</div>
                    <div class="options-grid">
                        ${q.options.map((option, optIndex) => `
                            <label class="option-label">
                                <input type="radio" name="q${index}" value="${optIndex}" required>
                                <span class="option-text">${option}</span>
                            </label>
                        `).join('')}
                    </div>
                </div>
            `).join('');

            questionsContainer.classList.add('active');
        }

        async function submitExam(event) {
            event.preventDefault();

            let score = 0;
            currentQuestions.forEach((q, index) => {
                const selected = document.querySelector(`input[name="q${index}"]:checked`);
                if (selected && parseInt(selected.value) === q.answer) {
                    score++;
                }
            });

            try {
                const response = await fetch('/submitExam', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        score: score,
                        topic: currentTopic,
                        totalQuestions: currentQuestions.length
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showResult(data.score, data.message);
                }
            } catch (error) {
                showError('Failed to submit exam');
            }
        }

        function showResult(score, message) {
            const modal = document.getElementById('resultModal');
            const resultIcon = document.getElementById('resultIcon');
            const resultTitle = document.getElementById('resultTitle');
            const resultMessage = document.getElementById('resultMessage');

            if (score >= 70) {
                resultIcon.className = 'fas fa-trophy';
                resultIcon.style.color = '#ffd93d';
                resultTitle.textContent = 'Excellent Work! 🎉';
            } else {
                resultIcon.className = 'fas fa-book-open';
                resultIcon.style.color = '#4ecdc4';
                resultTitle.textContent = 'Keep Learning! 💪';
            }

            resultMessage.textContent = `You scored ${score}% - ${message}`;
            modal.classList.add('active');
        }

        function closeModal() {
            const modal = document.getElementById('resultModal');
            modal.classList.remove('active');
            window.location = '/dashboard';
        }
    </script>
</body>
</html>