# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
# Rule 10: Must be a strong, random string of at least 32 characters in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-strong-session-secret-change-in-production

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/career-navigator

# AI API Configuration
API_KEY=your-openrouter-api-key

# Rule 8: Optional - Comma-separated list of allowed origins for CORS
# e.g., ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# If not set, development origins (localhost) are allowed ALLOWED_ORIGINS=